# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to upload (strongly recommended)
TELEGRAM_ALLOWED_USER_IDS=
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram-change-me
TELEGRAM_WEBHOOK_SECRET=
PORT=3000

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Or use local service account JSON path (do NOT commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin-key.json

# Firebase Web (if needed)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_OBJECT_PREFIX=
R2_ORIGINALS_PREFIX=originals
R2_THUMBNAILS_PREFIX=thumbnails

# Web upload / delete API (npm run start:upload; also mounted by the bot
# unless ENABLE_WEB_UPLOAD=false)
ENABLE_WEB_UPLOAD=
# Dashboard requests are authorized with the signed-in Google account's Firebase
# ID token; allowed emails come from Firestore settings/dashboard_auth plus:
ADMIN_EMAILS=
# Optional shared secret for the built-in upload page at GET / (keep it server-side only)
UPLOAD_SECRET=
# Comma-separated allowed origins (default: https://www.0xkxx.com,https://0xkxx.com,http://localhost:3000)
CORS_ORIGIN=
